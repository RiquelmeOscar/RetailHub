{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "npm install*": "allow",
      "npm ci*": "allow",
      "npm run *": "allow",
      "npx prisma *": "allow",
      "npx tsx *": "allow",
      "npx tsc *": "allow",
      "npx vite *": "allow",
      "docker compose *": "allow",
      "docker ps*": "allow",
      "curl *": "allow",
      "node *": "allow",
      "kill *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "cp *": "allow",
      "orca tab *": "allow",
      "orca snapshot*": "allow",
      "orca screenshot*": "allow",
      "orca goto*": "allow",
      "orca fill*": "allow",
      "orca click*": "allow",
      "orca keypress*": "allow",
      "orca wait*": "allow",
      "orca get *": "allow",
      "orca is *": "allow",
      "orca eval *": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git restore*": "deny",
      "git clean*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git commit --amend*": "deny",
      "git config*": "deny",
      "git remote*": "deny",
      "git tag*": "deny",
      "npm publish*": "deny",
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "docker system *": "deny",
      "docker volume *": "deny",
      "docker compose down*": "deny",
      "orca automations *": "deny"
    }
  }
}
